{
  "name": "@agentgate-builder/pkgguard",
  "version": "0.1.1",
  "mcpName": "co.youraitools/pkgguard",
  "description": "Dependency vulnerability and malicious package scanner for AI agents and MCP: check package.json, package-lock.json, requirements.txt, go.mod, Cargo.lock for known CVEs (GHSA, OSV) and malware before npm install. Free MCP server; full advisories via x402 pay-per-call API.",
  "type": "module",
  "main": "src/lite.js",
  "bin": {
    "pkgguard": "src/mcp-stdio.js",
    "pkgguard-mcp": "src/mcp-stdio.js"
  },
  "exports": {
    ".": "./src/lite.js",
    "./lite": "./src/lite.js",
    "./manifest": "./src/manifest.js",
    "./mcp": "./src/mcp-stdio.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/mcp-stdio.js",
    "src/lite.js",
    "src/paid.js",
    "src/manifest.js",
    "src/deadline.js",
    "src/version.js",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/node.js",
    "deploy": "wrangler deploy",
    "mcp": "node src/mcp-stdio.js"
  },
  "keywords": [
    "vulnerability-scanner",
    "dependency-check",
    "npm-audit",
    "security-audit",
    "cve",
    "osv",
    "malicious-packages",
