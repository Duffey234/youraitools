{
  "name": "@agentgate-builder/domaincheck",
  "version": "0.1.3",
  "description": "Disposable email check, email validation and domain reputation for AI agents: DNS, MX, SPF/DMARC/DKIM, RDAP domain age (WHOIS successor), disposable/role email detection and a 0-100 risk score. MCP server, library and x402 pay-per-call API.",
  "type": "module",
  "main": "src/check.js",
  "bin": {
    "domaincheck": "src/mcp-stdio.js",
    "domaincheck-mcp": "src/mcp-stdio.js"
  },
  "exports": {
    ".": "./src/check.js",
    "./check": "./src/check.js",
    "./email": "./src/email.js",
    "./dns": "./src/dns.js",
    "./rdap": "./src/rdap.js"
  },
  "files": [
    "src/mcp-stdio.js",
    "src/check.js",
    "src/email.js",
    "src/dns.js",
    "src/rdap.js",
    "src/mailauth.js",
    "src/data/disposable.js",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/node.js",
    "deploy": "wrangler deploy",
    "bazaar": "node scripts/bazaar-index.js",
    "mcp": "node src/mcp-stdio.js"
  },
  "keywords": [
    "disposable-email",
    "email-validation",
    "email-verification",
    "domain-reputation",
    "dmarc",
    "spf",
    "dkim",
    "rdap",
    "whois",
    "phishing",
    "fraud-detection",
    "mcp",
    "mcp-server",
    "ai-agents",
    "x402"
  ],
  "author": "agentgate-builder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://agentgate-source.pages.dev/x402-domain-check/"
  },
  "homepage": "https://api.youraitools.co/domaincheck",
  "bugs": {
    "url": "https://agentgate-source.pages.dev/x402-domain-check/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@coinbase/x402": "2.1.0",
    "@hono/node-server": "^1.19.9",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hono": "2.28.0",
    "hono": "^4.13.13",
    "viem": "^2.0.0",
    "wrangler": "^4.86.0",
    "x402": "1.2.0",
    "x402-fetch": "1.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
