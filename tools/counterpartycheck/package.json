  "main": "src/lite.js",
  "bin": {
    "counterpartycheck": "src/mcp-stdio.js",
    "counterpartycheck-mcp": "src/mcp-stdio.js"
  },
  "exports": {
    ".": "./src/lite.js",
    "./lite": "./src/lite.js",
    "./mcp": "./src/mcp-stdio.js",
    "./package.json": "./package.json"
  },
