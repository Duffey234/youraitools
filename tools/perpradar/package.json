{
  "name": "@agentgate-builder/perpradar",
  "version": "0.1.1",
  "mcpName": "co.youraitools/perpradar",
  "description": "Perp funding rates, open interest and positioning for trading agents: MCP server + client for PerpRadar. Funding normalized to 8h and APR, OI, mark/index premium, cross-venue median and spread, 7-day funding history and z-score, carry and a universe scan for funding extremes across Hyperliquid, dYdX v4, Paradex and Aevo. Free MCP preview; full data via x402 pay-per-call API. Read-only analytics. Not financial advice.",
  "type": "module",
  "main": "src/lite.js",
  "bin": {
    "perpradar": "src/mcp-stdio.js",
    "perpradar-mcp": "src/mcp-stdio.js"
  },
  "exports": {
    ".": "./src/lite.js",
    "./lite": "./src/lite.js",
    "./mcp": "./src/mcp-stdio.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/mcp-stdio.js",
    "src/lite.js",
    "src/paid.js",
    "src/deadline.js",
    "src/version.js",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/node.js",
    "deploy": "wrangler deploy",
    "mcp": "node src/mcp-stdio.js",
    "gen:examples": "node tools/gen-examples.mjs"
  },
  "keywords": [
    "funding-rate",
    "funding-rates",
