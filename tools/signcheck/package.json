{
  "name": "@agentgate-builder/signcheck",
  "version": "0.2.0",
  "mcpName": "co.youraitools/signcheck",
  "description": "Pre-sign safety check for AI agent wallets and MCP: decode a transaction, EIP-712 Permit / Permit2 / EIP-3009 signature, EIP-7702 delegation or x402 payment and flag drainer patterns (unlimited or EOA approvals, setApprovalForAll, fake USDC domains, x402 overpay, OFAC SDN). Free MCP server; full checks with on-chain facts and simulation via x402 pay-per-call API.",
  "type": "module",
  "main": "src/lite.js",
  "bin": {
    "signcheck": "src/mcp-stdio.js",
    "signcheck-mcp": "src/mcp-stdio.js"
  },
  "exports": {
    ".": "./src/lite.js",
    "./lite": "./src/lite.js",
    "./mcp": "./src/mcp-stdio.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/mcp-stdio.js",
    "src/lite.js",
    "src/paid.js",
    "src/deadline.js",
    "src/version.js",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/node.js",
    "deploy": "wrangler deploy",
    "mcp": "node src/mcp-stdio.js"
  },
  "keywords": [
    "wallet-security",
    "transaction-simulation",
    "safe-to-sign",
    "eip-712",
    "permit2",
    "eip-2612",
    "eip-3009",
    "eip-7702",
    "drainer",
    "approval-check",
    "x402",
    "mcp",
    "mcp-server",
    "ai-agents",
    "usdc",
    "base",
    "cloudflare-workers"
  ],
