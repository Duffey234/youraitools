{
  "name": "@agentgate-builder/tasignal",
  "version": "0.1.1",
  "mcpName": "co.youraitools/tasignal",
  "description": "Technical analysis, risk analytics and backtests for crypto trading agents: MCP server + client for TASignal. RSI, MACD, EMA 20/50/200, Bollinger, ATR, ADX, stochastic, realized volatility and a technical bias score; VaR/CVaR, drawdown, Sharpe/Sortino and ATR position sizing; SMA/EMA cross, RSI, breakout and MACD backtests. Free MCP preview; full data via x402 pay-per-call API. Read-only analytics. Not financial advice.",
  "type": "module",
  "main": "src/lite.js",
  "bin": {
    "tasignal": "src/mcp-stdio.js",
    "tasignal-mcp": "src/mcp-stdio.js"
  },
  "exports": {
    ".": "./src/lite.js",
    "./lite": "./src/lite.js",
    "./mcp": "./src/mcp-stdio.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/mcp-stdio.js",
    "src/lite.js",
    "src/paid.js",
    "src/deadline.js",
    "src/version.js",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/node.js",
    "deploy": "wrangler deploy",
    "mcp": "node src/mcp-stdio.js",
    "gen:examples": "node tools/gen-examples.mjs"
  },
  "keywords": [
    "technical-analysis",
    "technical-indicators",
    "rsi",
    "macd",
    "bollinger-bands",
    "backtest",
    "backtesting",
    "position-sizing",
    "value-at-risk",
    "crypto-trading",
    "trading-bot",
    "hyperliquid",
    "mcp",
    "mcp-server",
    "x402",
    "usdc",
    "ai-agents"
  ],
  "author": "agentgate-builder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://agentgate-source.pages.dev/x402-tasignal/"
  },
  "homepage": "https://api.youraitools.co/tasignal",
  "bugs": {
    "url": "https://agentgate-source.pages.dev/x402-tasignal/",
    "email": "hello@youraitools.co"
  },
  "engines": {
    "node": ">=20"
  },
